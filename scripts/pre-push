#!/usr/bin/env bash
# Pre-push hook: runs the same checks as CI before allowing a push.
set -euo pipefail

echo "==> pre-push: running CI checks..."

cd ui

echo "--- typecheck"
npm run typecheck

echo "--- lint"
npm run lint

echo "--- test"
npm run test

echo "--- build"
npm run build

cd ..

echo "--- markdownlint"
npx --yes markdownlint-cli2 "**/*.md" "#node_modules" "#**/node_modules" "#.git" "#CHANGELOG.md"

echo "==> pre-push: all checks passed"
